# ShopShip web. Copy to web/.env.local (gitignored).
API_URL=http://localhost:8080            # server-side + proxy target (never exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:8080   # API origin serving /media/** (enables next/image optimisation)
NEXT_PUBLIC_PAYMENT_MOCK=false           # true = show the TEST "simulate payer" buttons on the PromptPay page (API PAYMENT_PROVIDER=mock only)
NEXT_PUBLIC_USE_MOCKS=false              # true = serve docs/fixtures (synced to src/mocks/fixtures), no API needed
CLIENT_IP_HEADER=                        # e.g. x-real-ip (Railway) / cf-connecting-ip (Cloudflare)
