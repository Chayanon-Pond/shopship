# ShopShip API — every variable read by internal/config. Copy to api/.env (gitignored).
# No real keys anywhere in this repo. Mock providers are refused when APP_ENV=production.

PORT=8080
APP_ENV=development                 # development | staging | production
DATABASE_URL=                       # postgres://user:pass@host:5432/shopship?sslmode=disable (DB locale must be UTF-8, not C)
MIGRATE_ON_START=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000

COOKIE_SECURE=false                 # true in staging/production (refused false in production)
COOKIE_DOMAIN=
SESSION_TTL=720h

PAYMENT_PROVIDER=mock               # mock | omise
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

SHIPPING_CARRIER=flash_mock         # flash_mock | flash
SHIPPING_FLAT_RATE_SATANG=4000
RESERVATION_TTL=15m

STORAGE_DRIVER=local                # local (r2 later)
MEDIA_DIR=./data/media
EMAIL_DRIVER=log                    # log | file | resend. Production should use resend; log/file there boot with a loud warning (no mail reaches customers)
MAIL_DIR=./data/mail                # file driver: every mail is written here as <time>-<event>.eml + .html (open the .html in a browser)
RESEND_API_KEY=                     # required when EMAIL_DRIVER=resend (re_...; never commit a real key)
EMAIL_FROM=ShopShip <no-reply@shopship.local>   # resend: the sender domain must be verified in Resend
EMAIL_REPLY_TO=                     # optional reply-to address

# Shop assistant (POST /api/v1/assistant/chat). Works with no key (rule engine); set a key to use Claude.
ANTHROPIC_API_KEY=                  # empty = rule engine only
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASSISTANT_MODEL=claude-haiku-5-5    # claude-haiku-5-5 | claude-sonnet-5-5
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT=15s               # whole turn incl. tool rounds; then falls back to the rule engine
ASSISTANT_RATE_PER_MIN=20           # per IP and per signed-in user
ASSISTANT_CONTACT_LINE_URL=         # e.g. https://line.me/R/ti/p/@shopship (hand-off button); empty = email
ASSISTANT_CONTACT_EMAIL=support@shopship.example
ASSISTANT_CONTACT_PHONE=02-000-0000
